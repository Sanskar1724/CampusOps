# Copy to .env (backend) / configure per service. NEVER commit .env.

# --- Caspian (communication foundation; SDK reads nothing itself) ---
CASPIAN_API_KEY=
CASPIAN_BASE_URL=https://api.trycaspianai.com
# Operator-chosen agent mailbox local-part; ASK before channels.add("email", username=…).
CAMPUSOPS_MAILBOX=
# Optional: comma-separated allowed sender addresses/ids. Empty = everyone.
CASPIAN_ALLOWED_SENDERS=
# Optional hosted channels (email-only by default):
TELEGRAM_BOT_TOKEN=

# --- Backend ---
DATABASE_URL=sqlite:///./campusops.db
# Production (compose): DATABASE_URL=postgresql+psycopg2://campusops:campusops@db:5432/campusops
APP_SECRET_KEY=change-me-to-a-long-random-string
ENVIRONMENT=development
WORKER_INTERVAL_SECONDS=60

# --- AI (Core Agent model seam; OpenAI-compatible) ---
# Unset -> deterministic offline composer (retrieved facts only, no network).
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
MODEL=gpt-4o-mini

# --- College email ingestion (Gmail OAuth; NO passwords ever) ---
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REDIRECT_URI=http://localhost:8000/api/integrations/gmail/callback

# --- Frontend ---
NEXT_PUBLIC_API_URL=http://localhost:8000
