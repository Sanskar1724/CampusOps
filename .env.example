# Copy to .env when Phase 1 starts. NEVER commit .env.

# --- Caspian (communication foundation; SDK reads nothing itself) ---
CASPIAN_API_KEY=
CASPIAN_BASE_URL=https://api.trycaspianai.com
# Operator-chosen agent mailbox local-part; ASK before channels.add("email", username=…).
CAMPUSOPS_MAILBOX=
# Optional: comma-separated allowed sender addresses/ids. Empty = everyone.
CASPIAN_ALLOWED_SENDERS=
# Optional hosted channels (Phase 1 uses email only):
TELEGRAM_BOT_TOKEN=

# --- Backend ---
DATABASE_URL=postgresql+psycopg2://campusops:campusops@localhost:5432/campusops
APP_SECRET_KEY=change-me
ENVIRONMENT=development

# --- AI (Core Agent model seam; OpenAI-compatible) ---
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
MODEL=gpt-4o-mini

# --- College email ingestion (Gmail OAuth; NO passwords ever) ---
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
